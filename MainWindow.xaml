<Window x:Class="RustShieldNew.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rust Shield Scanner" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="#1A1A1A">
    
    <Border Background="#1E1E1E" BorderBrush="#333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок окна (для перетаскивания) -->
            <Border Grid.Row="0" Background="#252526" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock Text="🛡️" Foreground="#007ACC" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" RUST SHIELD SCANNER" Foreground="#007ACC" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <TextBlock x:Name="ScanProgressText" Text="Готов" Foreground="#888" FontSize="9" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MinimizeBtn" Content="─" Width="30" Height="30" Click="MinimizeBtn_Click" 
                                Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                        <Button x:Name="MaximizeBtn" Content="□" Width="30" Height="30" Click="MaximizeBtn_Click" 
                                Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                        <Button x:Name="CloseBtn" Content="✕" Width="30" Height="30" Click="CloseBtn_Click" 
                                Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Статус бар -->
            <Border Grid.Row="1" Background="#2D2D30" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="ГОТОВ" Foreground="#00A97A" FontWeight="Bold" FontSize="11"/>
                    <TextBlock x:Name="StatusSubText" Text="Система готова" Foreground="#888" FontSize="10" Margin="10,0,0,0" Grid.Column="1"/>
                    <TextBlock x:Name="TimeText" Grid.Column="3" Text="" Foreground="#888" FontSize="10"/>
                </Grid>
            </Border>
            
            <!-- Кнопки управления -->
            <Border Grid.Row="2" Padding="15,10" Background="#1E1E1E">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="QuickScanBtn" Content="⚡ БЫСТРАЯ" Click="QuickScan_Click" 
                                Width="100" Height="32" Margin="0,0,5,0" Background="#007ACC" 
                                Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="FullScanBtn" Content="🔍 ПОЛНАЯ" Click="FullScan_Click" 
                                Width="100" Height="32" Margin="5,0,5,0" Background="#007ACC" 
                                Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="DeepScanBtn" Content="🎯 ГЛУБОКАЯ" Click="DeepScan_Click" 
                                Width="100" Height="32" Margin="5,0,5,0" Background="#007ACC" 
                                Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="SendToTgBtn" Content="📤 В TG" Click="SendToTelegram_Click" 
                                Width="80" Height="32" Margin="5,0,5,0" Background="#26A5E4" 
                                Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="GenerateReportBtn" Content="📄 ОТЧЁТ" Click="GenerateReport_Click" 
                                Width="80" Height="32" Margin="5,0,5,0" Background="#444" 
                                Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="AutoScrollCheck" Content="📜 Автоскролл" IsChecked="True" 
                                  Foreground="#888" FontSize="9" VerticalAlignment="Center"/>
                        <Button Content="🗑️ ОЧИСТИТЬ" Click="ClearLog_Click" Width="80" Height="24" Margin="15,0,0,0" 
                                Background="#333" Foreground="#888" FontSize="9" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="💾 СОХРАНИТЬ" Click="SaveLog_Click" Width="80" Height="24" Margin="5,0,0,0" 
                                Background="#333" Foreground="#888" FontSize="9" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Таблица угроз -->
            <Border Grid.Row="3" Margin="10,5,10,5" MaxHeight="180" BorderBrush="#333" BorderThickness="1">
                <DataGrid x:Name="ThreatsGrid" 
                          AutoGenerateColumns="False" 
                          Background="#1E1E1E" 
                          Foreground="#CCCCCC"
                          RowBackground="#252526"
                          AlternatingRowBackground="#2D2D30"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#333333"
                          VerticalGridLinesBrush="Transparent"
                          RowHeight="24"
                          ColumnHeaderHeight="28">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="УРОВЕНЬ" Binding="{Binding Severity}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5,0,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="КРИТИЧНЫЙ">
                                            <Setter Property="Foreground" Value="#FF4444"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="ВЫСОКИЙ">
                                            <Setter Property="Foreground" Value="#FF8800"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="СРЕДНИЙ">
                                            <Setter Property="Foreground" Value="#FFCC00"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="НИЗКИЙ">
                                            <Setter Property="Foreground" Value="#00AA00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="УГРОЗА" Binding="{Binding Name}" Width="220">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ДЕТАЛИ" Binding="{Binding Details}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5,0,0,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ВРЕМЯ" Binding="{Binding Timestamp, StringFormat='HH:mm:ss'}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            
            <!-- Лог (консоль) -->
            <Border Grid.Row="4" Background="#1E1E1E" Margin="10,5,10,5" BorderBrush="#333" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Заголовок лога -->
                    <Border Grid.Row="0" Background="#252526" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 КОНСОЛЬ" Foreground="#007ACC" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text=" | " Foreground="#444" FontSize="10" Margin="8,0,0,0"/>
                            <TextBlock x:Name="ThreatsCount" Text="Угроз: 0" Foreground="#FF4444" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text=" | " Foreground="#444" FontSize="10" Margin="8,0,0,0"/>
                            <TextBlock x:Name="ScannedCount" Text="Проверено: 0" Foreground="#888" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Текст лога -->
                    <TextBox x:Name="LogBox" Grid.Row="1" 
                             Background="#1E1E1E" 
                             Foreground="#CCCCCC" 
                             FontFamily="Consolas" 
                             FontSize="10" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             Padding="5"/>
                </Grid>
            </Border>
            
            <!-- Нижняя панель -->
            <Border Grid.Row="5" Background="#252526" Padding="8,4" BorderBrush="#333" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="CpuText" Text="CPU: 0%" Foreground="#888" FontSize="9" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RamText" Text="RAM: 0 MB" Foreground="#888" FontSize="9" Margin="60,0,0,0" VerticalAlignment="Center" Grid.Column="1"/>
                    <TextBlock x:Name="ScanTimeText" Text="Последний скан: нет" Foreground="#888" FontSize="9" Margin="60,0,0,0" VerticalAlignment="Center" Grid.Column="2"/>
                    <TextBlock x:Name="ProcessesCount" Text="Процессы: 0" Foreground="#888" FontSize="9" Margin="60,0,0,0" VerticalAlignment="Center" Grid.Column="3"/>
                    
                    <!-- Кнопка обратной связи -->
                    <Button x:Name="FeedbackBtn" Grid.Column="4" Content="📞 ОБРАТНАЯ СВЯЗЬ" Click="FeedbackBtn_Click" 
                            Width="130" Height="22" Background="#333" Foreground="#007ACC" 
                            FontSize="9" FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
                </Grid>
            </Border>
            
            <!-- Прогресс бар (скрыт по умолчанию) -->
            <Border x:Name="ProgressPanel" Grid.Row="5" Background="#252526" Visibility="Collapsed" Padding="10,5">
                <ProgressBar x:Name="MainProgress" VerticalAlignment="Center" Height="3" Foreground="#007ACC" Background="#333"/>
            </Border>
        </Grid>
    </Border>
</Window>
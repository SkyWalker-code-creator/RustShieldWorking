<Window x:Class="RustShieldNew.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rust Shield" Height="650" Width="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="#0A0A0A">
    
    <Border Background="#111111" BorderBrush="#252525" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>
            
            <!-- ========== ВЕРХНЯЯ ПАНЕЛЬ ========== -->
            <Border Grid.Row="0" Background="#1A1A1A" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock Text="🛡️" Foreground="#E94560" FontSize="14"/>
                        <TextBlock Text=" RUST SHIELD" Foreground="#E94560" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MinimizeBtn" Content="─" Width="35" Height="35" Click="MinimizeBtn_Click" 
                                Background="Transparent" Foreground="#666" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                        <Button x:Name="MaximizeBtn" Content="□" Width="35" Height="35" Click="MaximizeBtn_Click" 
                                Background="Transparent" Foreground="#666" BorderThickness="0" FontSize="12" Cursor="Hand"/>
                        <Button x:Name="CloseBtn" Content="✕" Width="35" Height="35" Click="CloseBtn_Click" 
                                Background="Transparent" Foreground="#666" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ========== СТАТУС ========== -->
            <Border Grid.Row="1" Background="#0D0D0D" Padding="12,8">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#E94560" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="ГОТОВ" Foreground="#E94560" FontWeight="Bold" FontSize="11"/>
                        <TextBlock x:Name="StatusSubText" Text=" / Система готова" Foreground="#666" FontSize="11" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TimeText" HorizontalAlignment="Right" Foreground="#666" FontSize="10" FontFamily="Consolas"/>
                </Grid>
            </Border>
            
            <!-- ========== ОСНОВНАЯ ОБЛАСТЬ ========== -->
            <Grid Grid.Row="2" Margin="15,10,15,10">
                
                <!-- СТРАНИЦА 1: ГЛАВНАЯ -->
                <Grid x:Name="MainPage" Visibility="Visible">
                    <StackPanel>
                        
                        <!-- ЛОГОТИП ЩИТ -->
                        <Border Background="#1A1A1A" Padding="25,20" Margin="0,0,0,15">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#E94560" Width="70" Height="70" Margin="0,0,0,10">
                                    <TextBlock Text="🛡️" FontSize="40" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="RUST SHIELD" Foreground="#E94560" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Анти-чит система" Foreground="#666" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- КНОПКИ СКАНИРОВАНИЯ -->
                        <Border Background="#1A1A1A" Padding="15,12" Margin="0,0,0,15">
                            <WrapPanel HorizontalAlignment="Center">
                                <Button x:Name="QuickScanBtn" Content="БЫСТРАЯ" Click="QuickScan_Click" 
                                        Width="95" Height="34" Margin="5" Background="#1F6FEB" 
                                        Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                                <Button x:Name="FullScanBtn" Content="ПОЛНАЯ" Click="FullScan_Click" 
                                        Width="95" Height="34" Margin="5" Background="#238636" 
                                        Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                                <Button x:Name="DeepScanBtn" Content="ГЛУБОКАЯ" Click="DeepScan_Click" 
                                        Width="95" Height="34" Margin="5" Background="#DA3633" 
                                        Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                                <Button x:Name="GenerateReportBtn" Content="ОТЧЁТ" Click="GenerateReport_Click" 
                                        Width="85" Height="34" Margin="5" Background="#3D444D" 
                                        Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                            </WrapPanel>
                        </Border>
                        
                        <!-- КОНСОЛЬ (БЕЗ СКРОЛЛА) -->
                        <Border Background="#1A1A1A" Padding="0" Height="320">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Border Grid.Row="0" Background="#252525" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋 КОНСОЛЬ" Foreground="#E94560" FontSize="9" FontWeight="Bold"/>
                                        <Border Width="1" Background="#333" Margin="10,0,0,0"/>
                                        <TextBlock x:Name="ScannedCount" Text="Проверено: 0" Foreground="#8B949E" FontSize="9" Margin="10,0,0,0"/>
                                        <Border Width="1" Background="#333" Margin="10,0,0,0"/>
                                        <CheckBox x:Name="AutoScrollCheck" Content="Автоскролл" IsChecked="True" Foreground="#8B949E" FontSize="9" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                
                                <TextBox x:Name="LogBox" Grid.Row="1" 
                                         Background="#0D0D0D" 
                                         Foreground="#CCCCCC" 
                                         FontFamily="Consolas" 
                                         FontSize="10" 
                                         IsReadOnly="True" 
                                         TextWrapping="Wrap" 
                                         VerticalScrollBarVisibility="Auto" 
                                         BorderThickness="0"
                                         Padding="8"/>
                            </Grid>
                        </Border>
                        
                    </StackPanel>
                </Grid>
                
                <!-- СТРАНИЦА 2: О ПРОГРАММЕ -->
                <Grid x:Name="AboutPage" Visibility="Collapsed">
                    <Border Background="#1A1A1A" Padding="20">
                        <StackPanel VerticalAlignment="Center">
                            
                            <Button x:Name="BackBtn" Content="← НАЗАД" Click="BackBtn_Click" 
                                    Width="100" Height="32" Background="#252525" Foreground="#E94560" 
                                    FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,20"/>
                            
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#E94560" Width="60" Height="60" Margin="0,0,0,15">
                                    <TextBlock Text="🛡️" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <TextBlock Text="RUST SHIELD SCANNER" Foreground="#E94560" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Анти-чит система для Rust" Foreground="#666" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                
                                <Border Width="50" Height="1" Background="#333" Margin="0,15,0,15"/>
                                
                                <TextBlock Text="Обнаружение запрещённого ПО" Foreground="#8B949E" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="для игры Rust" Foreground="#8B949E" FontSize="12" HorizontalAlignment="Center"/>
                                
                                <Border Width="50" Height="1" Background="#333" Margin="0,15,0,15"/>
                                
                                <TextBlock Text="Разработчик: SkyWalker" Foreground="#E94560" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="Telegram: @Loksimen" Foreground="#8B949E" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                <TextBlock Text="Discord: maks8013" Foreground="#8B949E" FontSize="11" HorizontalAlignment="Center"/>
                                
                                <Border Width="50" Height="1" Background="#333" Margin="0,15,0,15"/>
                                
                                <TextBlock Text="© 2025 Rust Shield Team" Foreground="#666" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                
            </Grid>
            
            <!-- ========== НИЖНЯЯ ПАНЕЛЬ ========== -->
            <Border Grid.Row="3" Background="#1A1A1A" Padding="10,6" BorderBrush="#252525" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥️" Foreground="#666" FontSize="9"/>
                        <TextBlock x:Name="CpuText" Text=" 0%" Foreground="#8B949E" FontSize="9" Margin="4,0,15,0"/>
                        <TextBlock Text="💾" Foreground="#666" FontSize="9"/>
                        <TextBlock x:Name="RamText" Text=" 0 MB" Foreground="#8B949E" FontSize="9" Margin="4,0,0,0"/>
                    </StackPanel>
                    
                    <TextBlock x:Name="ScanTimeText" Grid.Column="1" Text="Последний скан: нет" Foreground="#666" FontSize="9" HorizontalAlignment="Center"/>
                    
                    <Button x:Name="FeedbackBtn" Grid.Column="2" Content="📞" Click="FeedbackBtn_Click" 
                            Width="24" Height="24" Background="#252525" Foreground="#E94560" 
                            FontSize="10" Cursor="Hand" BorderThickness="0"/>
                </Grid>
            </Border>
            
            <!-- ПРОГРЕСС -->
            <Border x:Name="ProgressPanel" Grid.Row="3" Background="#0D0D0D" Visibility="Collapsed" Padding="12,4">
                <ProgressBar x:Name="MainProgress" VerticalAlignment="Center" Height="3" Foreground="#E94560" Background="#333"/>
            </Border>
        </Grid>
    </Border>
</Window>